# .env.example — Required Environment Variables
#
# STATUS: STUB. Copy to `.env` locally (`.gitignore` keeps `.env` out of commits).
# These are the connection settings implied by the locked stack in AGENTS.md §2 —
# MS SQL Server via `mssql`, Redis-backed BullMQ, and Fastify. No secrets here.

# --- HTTP server ---
PORT=3000
NODE_ENV=development

# --- Microsoft SQL Server (js/config/db.js) ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=TODO_database_name
DB_USER=TODO_service_account
DB_PASSWORD=TODO
# Leave blank for SQL auth; set to "true" for Azure / encrypted connections.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=false

# --- Redis / BullMQ (js/config/queue.js) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# BullMQ needs a key prefix per environment so tenants/staging never collide.
REDIS_KEY_PREFIX=auc3810:

# --- Sessions / RBAC ---
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=TODO_generate_a_random_64_char_hex_string

# --- Timeouts locked by AGENTS.md §2 ---
# Round length in ms (7 seconds) and the client poll interval it pairs with.
ROUND_DURATION_MS=7000
CLIENT_POLL_INTERVAL_MS=400
